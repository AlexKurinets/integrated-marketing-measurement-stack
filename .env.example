# Connection string for the measurement warehouse (Postgres in this reference build; BigQuery in production).
DATABASE_URL=postgresql+psycopg://imms:imms@localhost:5432/imms
# Revenue value of one new subscription, used to turn incremental subscriptions into ROI.
VALUE_PER_CONVERSION=180
# Port the results API and the MCP server listen on.
API_PORT=8000
MCP_PORT=8001
